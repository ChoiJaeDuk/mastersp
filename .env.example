# =====================================================================
# 환경 변수 템플릿
#
# 이 파일을 .env.local 로 복사한 뒤 실제 값을 채운다. (.env.local 은 커밋되지 않음)
#   cp .env.example .env.local
# =====================================================================

# ---------------------------------------------------------------------
# PostgreSQL
#
# DB_ADDRESS / DB_ID / DB_NAME 중 하나라도 비어 있으면 "DB 미연결 모드"로 동작한다.
#   - 커넥션 풀을 만들지 않으므로 DB 없이도 사이트가 그대로 뜬다.
#   - 약관 페이지 본문은 "등록된 내용이 없습니다." 로 표시된다.
#   - 고객문의는 저장되지 않고 서버 콘솔에만 기록된다. (화면은 접수 완료로 표시)
# ---------------------------------------------------------------------
DB_ADDRESS=
DB_PORT=5432
DB_ID=
DB_PASSWORD=
DB_NAME=

# ---------------------------------------------------------------------
# next-auth (관리자 인증)
#   시크릿 생성:  openssl rand -base64 32
# ---------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3939
NEXTAUTH_SECRET=

# ---------------------------------------------------------------------
# 메일 발송 (문의 접수 알림 / 답변 회신)
# ---------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# 보내는 사람
MAIL_FROM="장인의공간 <master@masterspace.co.kr>"
# 문의 접수 알림을 받을 담당자 (쉼표로 여러 명)
MAIL_ADMIN_TO=master@masterspace.co.kr

# ---------------------------------------------------------------------
# 첨부파일 저장 경로 (public 밖에 두고 /api/attachment 로 스트리밍)
# ---------------------------------------------------------------------
UPLOAD_BASE_PATH=./storage/upload
