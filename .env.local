# =====================================================================
# 환경 변수 템플릿
#
# 이 파일을 .env.local 로 복사한 뒤 실제 값을 채운다. (.env.local 은 커밋되지 않음)
#   cp .env.example .env.local
# =====================================================================

# ---------------------------------------------------------------------
# MySQL (신규 홈페이지 DB)
#
# 레거시와 같은 서버 / 같은 스키마를 쓴다. 계정 권한이 masterspace_co_kr 에만
# 있어서 별도 DB 를 만들 수 없기 때문이다. 레거시 테이블은 tb_*, 신규는 TBL_*
# 이라 이름이 겹치지 않는다.
#
# ⚠ 비밀번호에 # 가 있어 반드시 따옴표로 감싸야 한다.
#   따옴표가 없으면 dotenv 가 # 앞까지만 값으로 읽는다. (wkdrhd12 로 잘림)
# ---------------------------------------------------------------------
DB_ADDRESS=db.masterspace.co.kr
DB_PORT=3306
DB_ID=masterspace
DB_PASSWORD="wkdrhd12#!@#"
DB_NAME=masterspace_co_kr

# ---------------------------------------------------------------------
# next-auth (관리자 인증)
#   시크릿 생성:  openssl rand -base64 32
# ---------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3939
NEXTAUTH_SECRET=is5lhFF+8YsGRZnQfWcanoGpNlNKuwr2HqZ4ZH0MJyE=

# ---------------------------------------------------------------------
# 메일 발송 (문의 접수 알림 / 답변 회신)
# ---------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# 보내는 사람
MAIL_FROM="장인의공간 <master@masterspace.co.kr>"
# 문의 접수 알림을 받을 담당자 (쉼표로 여러 명)
MAIL_ADMIN_TO=master@masterspace.co.kr

# ---------------------------------------------------------------------
# 첨부파일 저장 경로 (public 밖에 두고 /api/attachment 로 스트리밍)
# ---------------------------------------------------------------------
UPLOAD_BASE_PATH=./storage/upload

# 원본 소스(kor/company/company.html)에 있던 테스트 서버 키. 도메인 등록 필요.
NEXT_PUBLIC_KAKAO_MAP_KEY=634cc3048638e652433f80d278812b3e

# ---------------------------------------------------------------------
# 레거시 MySQL (회사홈페이지) - 데이터 마이그레이션 전용
#
# 운영 DB 이므로 조회만 한다. scripts/legacy-*.mjs 에서만 사용한다.
# 출처: 레거시 INC/dbcon.php + INC/dbConn.php
# ---------------------------------------------------------------------
LEGACY_DB_HOST=db.masterspace.co.kr
LEGACY_DB_PORT=3306
LEGACY_DB_USER=masterspace
# 위와 마찬가지로 # 때문에 따옴표가 필요하다.
LEGACY_DB_PASSWORD="wkdrhd12#!@#"
LEGACY_DB_NAME=masterspace_co_kr
